<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/info_dialog_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/helpTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/game_help_dialog_title"
        android:textColor="@color/game_text_primary"
        android:textStyle="bold"
        android:textSize="20sp"
        android:gravity="center"
        android:paddingBottom="10dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCD9E2EC" />

    <TextView
        android:id="@+id/helpBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/game_text_secondary"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:gravity="start" />

</LinearLayout>

