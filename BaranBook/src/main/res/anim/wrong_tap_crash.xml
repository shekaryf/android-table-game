<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="false">

    <translate
        android:duration="70"
        android:fromXDelta="0dp"
        android:toXDelta="3dp" />

    <rotate
        android:duration="70"
        android:fromDegrees="0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toDegrees="14" />

    <scale
        android:duration="70"
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="0.86"
        android:toYScale="0.86" />

    <alpha
        android:duration="70"
        android:fromAlpha="1.0"
        android:toAlpha="0.55" />

    <translate
        android:duration="80"
        android:fromXDelta="3dp"
        android:startOffset="70"
        android:toXDelta="-3dp" />

    <rotate
        android:duration="80"
        android:fromDegrees="14"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="70"
        android:toDegrees="-14" />

    <translate
        android:duration="120"
        android:fromXDelta="-3dp"
        android:startOffset="150"
        android:toXDelta="0dp" />

    <rotate
        android:duration="120"
        android:fromDegrees="-14"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="150"
        android:toDegrees="0" />

    <scale
        android:duration="120"
        android:fromXScale="0.86"
        android:fromYScale="0.86"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="150"
        android:toXScale="1.0"
        android:toYScale="1.0" />

    <alpha
        android:duration="120"
        android:fromAlpha="0.55"
        android:startOffset="150"
        android:toAlpha="1.0" />

</set>

