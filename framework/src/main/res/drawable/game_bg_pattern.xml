<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Light green gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="@color/DefaultGradiantCenter"
                android:endColor="@color/DefaultGradiantEnd"
                android:startColor="@color/DefaultGradiantStart"
                android:type="linear"
                android:useLevel="false" />
        </shape>
    </item>

